# Testnet only. Never put mainnet keys here.
NEAR_NETWORK=sandbox            # sandbox | testnet   (anything else -> ERR_MAINNET_REFUSED); gen-testnet-near-key needs testnet
NEAR_RPC_URL=                   # testnet mode only; keep empty for sandbox. gen-testnet-near-key fills in https://rpc.testnet.near.org when empty and NEAR_NETWORK=testnet; any testnet RPC works, e.g. https://near-testnet.drpc.org
MPC_CONTRACT_ID=v1.signer-prod.testnet
CLAWGUARD_CONTRACT_ID=          # e.g. clawguard.<owner>.testnet
OWNER_ACCOUNT_ID=               # <owner>.testnet
OWNER_PRIVATE_KEY=              # testnet full-access key, setup scripts only; npm run gen-testnet-near-key -- --role owner
AGENT_ACCOUNT_ID=               # agent-1.<owner>.testnet
AGENT_PRIVATE_KEY=              # the function-call key (ed25519:...); make it with: npm run gen-testnet-near-key -- --role agent
GUARDIAN_ACCOUNT_ID=            # optional
GUARDIAN_PRIVATE_KEY=           # optional fc key, method pause only; npm run gen-testnet-near-key -- --role guardian
DEMO_TARGET=hl                  # hl | base
HL_API_URL=https://api.hyperliquid-testnet.xyz
HL_MASTER_ADDRESS=              # testnet-only master (0x...)
HL_MASTER_TESTNET_PRIVATE_KEY=  # throwaway, testnet only, used once by approve_hl_agent
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_SEPOLIA_USDC=0x036CbD53842c5426634e7929541eC2318f3dCF7e   # Circle test USDC on Base Sepolia
AGENT_MODE=scripted             # scripted | llm
LLM_API_KEY=                    # optional, llm mode only
CLAW_WATCH_INTERVAL_SEC=15
CLAW_WATCH_AUTOPAUSE=0
TELEGRAM_ALERTS_ENABLED=0       # optional Telegram alerts; demo works with 0
TELEGRAM_BOT_TOKEN=             # your own bot token; .env only, never committed
TELEGRAM_CHAT_ID=               # owner chat id; .env only
